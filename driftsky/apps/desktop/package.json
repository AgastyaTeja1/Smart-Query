{
  "name": "@driftsky/desktop",
  "productName": "Driftsky",
  "version": "1.0.0",
  "description": "Weather for your desktop.",
  "private": true,
  "main": "dist/main.cjs",
  "author": "Driftsky",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "test": "vitest run",
    "e2e": "node scripts/build.mjs && xvfb-run -a -s \"-screen 0 1440x900x24\" playwright test --trace off",
    "typecheck": "tsc -p .",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac",
    "dist:win": "node scripts/build.mjs && electron-builder --win",
    "dist:linux": "node scripts/build.mjs && electron-builder --linux dir"
  },
  "dependencies": {
    "koffi": "2.9.2"
  },
  "devDependencies": {
    "@driftsky/engine": "^1.0.0",
    "@fontsource-variable/inter": "^5.1.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.2.2",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21",
    "zod": "^3.24.2"
  }
}
