# Copy to .env (never commit it) or set these in your host's environment.
NODE_ENV=production
PORT=5173
PUBLIC_URL=https://driftsky.app
DEVICE_SALT=change-me-to-a-long-random-string
DATABASE_PATH=./data/driftsky.db
RELEASES_PATH=./data/releases.json
TRUST_PROXY=1

PAYMENTS=stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# optional: pre-created Stripe prices instead of inline amounts
# STRIPE_PRICE_ONE=price_...
# STRIPE_PRICE_FIVE=price_...
# STRIPE_PRICE_UPGRADE=price_...

MAIL=resend
RESEND_API_KEY=re_...
MAIL_FROM=Driftsky <keys@driftsky.app>
SUPPORT_EMAIL=support@driftsky.app
