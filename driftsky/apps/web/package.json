{
  "name": "@driftsky/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --clear-screen=false server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --target=node22 --bundle --packages=external --format=esm --outfile=dist/server.js",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning dist/server.js",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vite": "^5.4.14"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  }
}
